 F T    #...........#,,#........#.......#,,#L..........#      F 
 F      ####DD#######,,####DD######DD####,,#####DD######      F 
 F      W,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,W    T F 
 F      #,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,#      F 
 F      #,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,#      F 
 F      #####DD######,,##DD####DD####DD##,,#############      F 
 F      #...........#,,#....L#....#.....#,,#L..........#      F 
 F      #...........#,,#.....#....#.....#,,#...........#      F 
