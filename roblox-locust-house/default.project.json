{
  "name": "DomSaranchi",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "LocustShared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "LocustServer": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
